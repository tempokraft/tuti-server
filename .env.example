# Copy to .env (or export directly) before running the server.

# Which vision LLM backend to use: "openai" (default) or "anthropic".
ANALYSIS_BACKEND=openai

# Required to actually reach the model — set the key for whichever backend
# ANALYSIS_BACKEND points at. See README for credential resolution order if
# you'd rather use `ant auth login` (Anthropic) instead of a raw key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — defaults shown. ANALYSIS_MODEL's default depends on
# ANALYSIS_BACKEND (gpt-5.2 for openai, claude-opus-5 for anthropic); set it
# explicitly to override.
PORT=8080
STORAGE_DIR=./data/captures
SESSION_DIR=./data/sessions
ANALYSIS_MODEL=
MAX_UPLOAD_BYTES=10485760

# Set to true to enable development-only endpoints (POST /dev/Prompt).
# Never enable in production.
DEV_MODE=false
