# Copy to .env (or export directly) before running the server.

# Required to actually reach Claude — see README for credential resolution
# order if you'd rather use `ant auth login` instead.
ANTHROPIC_API_KEY=

# Optional — defaults shown.
PORT=8080
STORAGE_DIR=./data/captures
ANTHROPIC_MODEL=claude-opus-5
MAX_UPLOAD_BYTES=10485760
